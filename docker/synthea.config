# Project override config for Synthea v3.3.0
# Passed via `-c synthea.config`. Any setting not listed here falls back
# to Synthea's built-in defaults (src/main/resources/synthea.properties).
# Full reference: https://github.com/synthetichealth/synthea/wiki/Common-Configuration

exporter.csv.export = true

exporter.fhir.export = false
exporter.ccda.export = false
exporter.cpcds.export = false

generate.append_numbers_to_person_names = false